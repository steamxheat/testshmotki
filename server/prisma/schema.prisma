// Шмотки — модель данных (§12 ТЗ). Все суммы — в сотых долях валюты магазина.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------

enum StoreStatus {
  active
  blocked
}

enum MemberRole {
  owner
  manager
}

enum CategoryStatus {
  active
  hidden
  archived
}

enum ProductStatus {
  draft
  published
  reserved
  sold
  archived
}

enum ProductCondition {
  new_with_tag // новое с биркой
  new_no_tag // новое без бирки
  excellent // отличное
  good // хорошее
  has_issues // есть нюансы
}

enum OrderStatus {
  pending // ожидает подтверждения
  confirmed // подтверждён
  sent // передан перевозчику или покупателю назначена встреча
  rejected // отклонён
  completed // завершён
  cancelled // отменён покупателем
  expired // бронь истекла
}

enum DeliveryMethod {
  meetup // встреча
  cdek // СДЭК
  russian_post // Почта России
  yandex_delivery // Яндекс Доставка
  dhl // DHL
  discuss // обсудить с продавцом
}

enum ReviewStatus {
  published
  hidden
}

enum EventType {
  store_view
  catalog_view
  filter_apply
  search_query
  product_view
  favorite_add
  favorite_remove
  buy_click
  order_created
  chat_open
  order_status_change
  review_published
}

enum ReportStatus {
  open
  resolved
  dismissed
}

enum ReportTarget {
  product
  review
}

// ---------- models ----------

model User {
  id         String    @id @default(cuid())
  telegramId BigInt    @unique @map("telegram_id")
  username   String?
  firstName  String?   @map("first_name")
  lastName   String?   @map("last_name")
  avatarUrl  String?   @map("avatar_url")
  phone      String?
  contactName String?  @map("contact_name")
  contactEmail String? @map("contact_email")
  deliveryCity String? @map("delivery_city")
  deliveryAddress String? @map("delivery_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")

  memberships StoreMember[]
  favorites   Favorite[]
  orders      Order[]
  reviews     Review[]
  events      Event[]
  chatThreads ChatThread[]
  chatMessages ChatMessage[]
  legalNotices LegalNotice[]
  subscription ProductSubscription[]

  @@map("users")
}

model Store {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  description     String?
  logoUrl         String?     @map("logo_url")
  coverUrl        String?     @map("cover_url")
  city            String?
  contactUsername String?     @map("contact_username")
  status          StoreStatus @default(active)
  // settings хранит необязательные настройки магазина (§7.6): способы получения,
  // график ответа, правила брони, соцсети, акцентный цвет, showSold, slugChangedAt.
  settings        Json        @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at")

  members    StoreMember[]
  categories Category[]
  products   Product[]
  orders     Order[]
  reviews    Review[]
  events     Event[]
  chatThreads ChatThread[]
  legalNotices LegalNotice[]
  subscriptions ProductSubscription[]

  @@map("stores")
}

model StoreMember {
  id        String     @id @default(cuid())
  storeId   String     @map("store_id")
  userId    String     @map("user_id")
  role      MemberRole @default(manager)
  createdAt DateTime   @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@map("store_members")
}

model LegalNotice {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  version   String
  decision  String
  decidedAt DateTime @default(now()) @map("decided_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId, version])
  @@map("legal_notices")
}

model Category {
  id        String         @id @default(cuid())
  storeId   String         @map("store_id")
  parentId  String?        @map("parent_id")
  name      String
  sortOrder Int            @default(0) @map("sort_order")
  status    CategoryStatus @default(active)

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([storeId])
  @@map("categories")
}

model Product {
  id             String           @id @default(cuid())
  storeId        String           @map("store_id")
  categoryId     String?          @map("category_id")
  title          String
  description    String?
  priceAmount    Int              @map("price_amount") // сотые доли валюты магазина
  oldPriceAmount Int?             @map("old_price_amount")
  brand          String?
  size           String?
  color          String?
  condition      ProductCondition
  defects        String?
  gender         String?
  material       String?
  measurements   String?
  defectImages   Json             @default("[]") @map("defect_images")
  videoUrl       String?          @map("video_url")
  channelPostId  Int?             @map("channel_post_id")
  channelPostChat String?         @map("channel_post_chat")
  channelPostAt  DateTime?        @map("channel_post_at")
  channelPostError String?        @map("channel_post_error")
  sellerSku      String?          @map("seller_sku")
  status         ProductStatus    @default(draft)
  publishedAt    DateTime?        @map("published_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category?      @relation(fields: [categoryId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]
  orderItems OrderItem[]
  favorites Favorite[]
  orders   Order[]
  events   Event[]
  chatMessages ChatMessage[]

  @@index([storeId, status])
  @@map("products")
}

model ProductSubscription {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  userId      String   @map("user_id")
  newArrivals Boolean  @default(false) @map("new_arrivals")
  priceDrops  Boolean  @default(false) @map("price_drops")
  categoryIds String[] @default([]) @map("category_ids")
  brands      String[] @default([])
  sizes       String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([storeId, newArrivals, priceDrops])
  @@map("product_subscriptions")
}

model ProductVariant {
  id               String @id @default(cuid())
  productId        String @map("product_id")
  size             String
  stockQuantity    Int    @default(1) @map("stock_quantity")
  reservedQuantity Int    @default(0) @map("reserved_quantity")
  soldQuantity     Int    @default(0) @map("sold_quantity")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size])
  @@map("product_variants")
}

model ProductImage {
  id        String @id @default(cuid())
  productId String @map("product_id")
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model Order {
  id                   String         @id @default(cuid())
  publicNumber         String         @unique @map("public_number")
  storeId              String         @map("store_id")
  productId            String         @map("product_id")
  buyerId              String         @map("buyer_id")
  // снимок товара на момент заказа — не меняется при редактировании товара (§7.2)
  productTitleSnapshot String         @map("product_title_snapshot")
  priceAmountSnapshot  Int            @map("price_amount_snapshot")
  buyerName            String         @map("buyer_name")
  buyerUsername        String?        @map("buyer_username")
  buyerPhone           String?        @map("buyer_phone")
  buyerEmail           String?        @map("buyer_email")
  city                 String?
  deliveryAddress      String?        @map("delivery_address")
  deliveryPoint        String?        @map("delivery_point")
  deliveryPointCode    String?        @map("delivery_point_code")
  deliveryCityCode     Int?           @map("delivery_city_code")
  deliveryTariff       String?        @map("delivery_tariff")
  deliveryPriceAmount  Int?           @map("delivery_price_amount")
  deliveryLat          Float?         @map("delivery_lat")
  deliveryLon          Float?         @map("delivery_lon")
  deliveryMethod       DeliveryMethod @map("delivery_method")
  comment              String?
  receiptFilename      String?        @map("receipt_filename")
  receiptSubmittedAt   DateTime?      @map("receipt_submitted_at")
  receiptReviewRemindedAt DateTime?    @map("receipt_review_reminded_at")
  paymentConfirmedAt   DateTime?      @map("payment_confirmed_at")
  rejectionReason      String?        @map("rejection_reason")
  refundAmount         Int?           @map("refund_amount")
  refundConfirmedAt    DateTime?      @map("refund_confirmed_at")
  refundReference      String?        @map("refund_reference")
  personalDataConsentAt DateTime?      @map("personal_data_consent_at")
  termsAcceptedAt      DateTime?      @map("terms_accepted_at")
  legalVersion         String?        @map("legal_version")
  status               OrderStatus    @default(pending)
  reservedUntil        DateTime?      @map("reserved_until")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  store   Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  buyer   User  @relation(fields: [buyerId], references: [id])
  history OrderStatusHistory[]
  items   OrderItem[]
  review  Review?
  shipment Shipment?

  @@index([storeId, status])
  @@index([buyerId])
  @@map("orders")
}

model Shipment {
  id              String   @id @default(cuid())
  orderId         String   @unique @map("order_id")
  storeId         String   @map("store_id")
  carrier         String
  mode            String
  state           String   @default("creating")
  requestUuid     String?  @map("request_uuid")
  externalUuid    String?  @map("external_uuid")
  trackingNumber  String?  @map("tracking_number")
  originPoint     String?  @map("origin_point")
  tariffCode      Int?     @map("tariff_code")
  tariffName      String?  @map("tariff_name")
  priceAmount     Int?     @map("price_amount")
  error           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("shipments")
}

model OrderItem {
  id                  String @id @default(cuid())
  orderId             String @map("order_id")
  productId           String @map("product_id")
  variantId           String @map("variant_id")
  titleSnapshot       String @map("title_snapshot")
  sizeSnapshot        String @map("size_snapshot")
  priceAmountSnapshot Int    @map("price_amount_snapshot")
  quantity            Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String       @map("order_id")
  oldStatus      OrderStatus? @map("old_status")
  newStatus      OrderStatus  @map("new_status")
  changedByUserId String?     @map("changed_by_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model ChatThread {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  buyerId   String   @map("buyer_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  buyer    User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([storeId, buyerId])
  @@index([storeId, updatedAt])
  @@map("chat_threads")
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  senderId  String   @map("sender_id")
  productId String?  @map("product_id")
  text      String
  mediaUrl  String?  @map("media_url")
  mediaType String?  @map("media_type")
  createdAt DateTime @default(now()) @map("created_at")

  thread  ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender  User       @relation(fields: [senderId], references: [id])
  product Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([mediaUrl])
  @@map("chat_messages")
}

model Review {
  id         String       @id @default(cuid())
  orderId    String       @unique @map("order_id")
  storeId    String       @map("store_id")
  authorId   String       @map("author_id")
  rating     Int // 1..5
  text       String?
  photos     Json         @default("[]") // массив url (§6.9, до 3 фото)
  sellerReply String?     @map("seller_reply")
  status     ReviewStatus @default(published)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store  Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([storeId, status])
  @@map("reviews")
}

model Event {
  id        String    @id @default(cuid())
  storeId   String?   @map("store_id")
  userId    String?   @map("user_id")
  productId String?   @map("product_id")
  type      EventType
  meta      Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at")

  store   Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([storeId, type, createdAt])
  @@map("events")
}

// Жалобы на товар/отзыв для модерации суперадмином (§4.3, §7.5)
model Report {
  id         String       @id @default(cuid())
  storeId    String?      @map("store_id")
  targetType ReportTarget @map("target_type")
  targetId   String       @map("target_id")
  reason     String?
  status     ReportStatus @default(open)
  createdByUserId String? @map("created_by_user_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@map("reports")
}

// Журнал действий суперадмина (§9.9)
model AdminAuditLog {
  id        String   @id @default(cuid())
  actorTelegramId BigInt @map("actor_telegram_id")
  action    String
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_audit_log")
}

model BotNotification {
  id            String    @id @default(cuid())
  telegramId    BigInt    @map("telegram_id")
  body          String
  buttonText    String?   @map("button_text")
  buttonPath    String?   @map("button_path")
  storeSlug     String?   @map("store_slug")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lockedUntil   DateTime? @map("locked_until")
  sentAt        DateTime? @map("sent_at")
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([sentAt, nextAttemptAt])
  @@map("bot_notifications")
}
