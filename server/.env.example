# --- База данных (docker-compose поднимает Postgres на 5434) ---
DATABASE_URL="postgresql://shmotki:shmotki@localhost:5434/shmotki?schema=public"

# --- Сервер ---
NODE_ENV=development
ALLOW_DEV_AUTH=1
PORT=4000
# Публичный адрес API (для формирования URL картинок)
PUBLIC_API_URL=http://localhost:4000
# Адрес Mini App (используется в кнопках уведомлений бота)
WEBAPP_URL=http://localhost:5173
# CORS: адрес клиента в dev
WEB_ORIGIN=http://localhost:5173

# --- Telegram ---
# Токен бота от @BotFather. Без него уведомления и проверка initData в проде не работают.
BOT_TOKEN=
# username бота без @ (для построения ссылок t.me/<bot>/app)
BOT_USERNAME=shmotki_app_bot
# Сколько секунд initData считается валидной (§10)
INITDATA_MAX_AGE_SEC=86400
# Запускать long-polling бота внутри процесса сервера (1/0)
BOT_POLLING=1

# Отдельный постоянный секрет для шифрования ключей перевозчиков. Не меняйте после подключения СДЭК.
# Сгенерируйте, например, командой: openssl rand -hex 32
CARRIER_ENCRYPTION_KEY=

# --- Единственный магазин этой установки ---
STORE_OWNER_TELEGRAM_ID=
STORE_SLUG=nikita
STORE_NAME=Мой магазин
STORE_CONTACT_USERNAME=

# --- Бронь ---
RESERVATION_HOURS=24
# СДЭК: ключи договора продавца. Без них покупатель указывает ПВЗ вручную.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=

# В production Express может сам отдавать собранный web/dist.
# WEB_DIST=/absolute/path/to/web/dist
