# Одна установка = один продавец, один бот, одна база. Не копируйте секреты другого магазина.
NODE_ENV=production
ALLOW_DEV_AUTH=0
PORT=8080
DATABASE_URL=postgresql://shmotki:CHANGE_ME@127.0.0.1:5433/shmotki?schema=public
# Только для Docker Compose: без значения запуск должен остановиться.
POSTGRES_PASSWORD=

BOT_TOKEN=PASTE_BOTFATHER_TOKEN
BOT_USERNAME=your_shop_bot
BOT_POLLING=1
STORE_OWNER_TELEGRAM_ID=PASTE_OWNER_TELEGRAM_ID
STORE_SLUG=your_shop
STORE_NAME=Мой магазин
STORE_CONTACT_USERNAME=

WEBAPP_URL=https://shop.example.com/shmotki/
WEB_ORIGIN=https://shop.example.com
PUBLIC_API_URL=https://shop.example.com
WEB_DIST=/absolute/path/to/shmotki/web/dist

RESERVATION_HOURS=24
INITDATA_MAX_AGE_SEC=86400
# Сгенерируйте отдельный ключ: openssl rand -hex 32. Сохраните его вне бэкапа БД.
CARRIER_ENCRYPTION_KEY=PASTE_64_HEX_CHARACTERS

# Необязательно. При подключении СДЭК ключи вводятся владельцем в Mini App.
# CDEK_API_URL=https://api.cdek.ru/v2
