# Скопируйте в .env.prod и заполните. Используется docker-compose.prod.yml.

# Публичный HTTPS-адрес, по которому открывается сайт и Mini App.
# Должен совпадать с Web App URL в @BotFather. Напр.: https://shop.example.com
PUBLIC_URL=https://example.com

# Внешний порт nginx (обычно 80; за внешним HTTPS-прокси можно 8080)
WEB_PORT=80

# Telegram
BOT_TOKEN=123456:ABC...        # от @BotFather
BOT_USERNAME=shmotki_app_bot   # без @
BOT_POLLING=1                  # 1 — long polling внутри сервера

# Telegram ID суперадминистраторов через запятую
SUPERADMIN_IDS=

# База данных (внутренняя, между контейнерами)
POSTGRES_USER=shmotki
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=shmotki

# Бронь, часов
RESERVATION_HOURS=24

# Засеять демо-магазин при первом старте (1/0)
SEED_ON_START=0
